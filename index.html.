<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101014">
<title>The Musical Instruments Quiz</title>
<style>
:root{--bg:#0b0d12;--panel:#151922;--gold:#e8b957;--gold2:#ffd98a;--muted:#aeb4c1;--line:#343947;--good:#69d39a;--bad:#ff8585}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 15% 5%,#263044 0,transparent 34%),radial-gradient(circle at 90% 90%,#382817 0,transparent 30%),var(--bg);color:#f7f3ea;font-family:Georgia,'Times New Roman',serif;padding:24px}
.wrap{max-width:920px;margin:0 auto}.top{text-align:center;margin:18px 0 26px}.eyebrow{letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font:700 11px Arial,sans-serif}.top h1{font-size:clamp(34px,7vw,64px);line-height:1.02;margin:12px 0 8px}.top h1 span{color:var(--gold)}.top p{color:var(--muted);font:15px/1.5 Arial,sans-serif;margin:0}
.card{background:linear-gradient(145deg,rgba(26,31,42,.97),rgba(13,16,22,.98));border:1px solid #66502d;border-radius:22px;padding:clamp(18px,4vw,32px);box-shadow:0 18px 60px #0008}
.levels{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:20px 0}.level{border:1px solid var(--line);background:#11151d;color:#eee;border-radius:13px;padding:14px 8px;cursor:pointer;font-weight:bold}.level small{display:block;color:var(--muted);font:12px Arial,sans-serif;margin-top:5px}.level.active{border-color:var(--gold);background:#302719;box-shadow:0 0 0 1px #e8b95744}
button{font:inherit}.primary{background:linear-gradient(100deg,var(--gold),var(--gold2));color:#19140b;border:0;border-radius:13px;padding:14px 22px;font-weight:800;cursor:pointer;width:100%;font:700 15px Arial,sans-serif}.primary:disabled{opacity:.45;cursor:not-allowed}
.meta{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font:13px Arial,sans-serif;margin-bottom:12px}.bar{height:7px;background:#303642;border-radius:10px;overflow:hidden;margin-bottom:25px}.fill{height:100%;background:linear-gradient(90deg,var(--gold),#fff0b3);width:0;transition:width .25s}
.q{font-size:clamp(22px,4vw,32px);line-height:1.25;margin:0 0 22px}.answers{display:grid;grid-template-columns:1fr 1fr;gap:12px}.answer{border:1px solid var(--line);border-radius:14px;background:#10141c;color:#f7f3ea;text-align:left;padding:16px;cursor:pointer;display:flex;gap:12px;align-items:center;min-height:62px;font:15px Arial,sans-serif}.answer:hover{border-color:var(--gold)}.letter{width:30px;height:30px;border-radius:50%;background:#342a19;color:var(--gold2);display:grid;place-items:center;font-weight:bold;flex:none}.answer.selected{border-color:var(--gold);background:#2c2519}.answer.correct{border-color:var(--good);background:#14281f}.answer.wrong{border-color:var(--bad);background:#2b191b}
.feedback{margin:18px 0;padding:14px;border-radius:12px;background:#10141c;color:var(--muted);font:14px/1.5 Arial,sans-serif}.feedback.good{border:1px solid #397b59;color:#baf2d2}.feedback.bad{border:1px solid #8c4545;color:#ffc5c5}
.actions{display:flex;gap:12px;margin-top:18px}.actions .primary{flex:1}.secondary{border:1px solid var(--line);background:#10141c;color:#eee;border-radius:13px;padding:13px 18px;cursor:pointer;font:14px Arial,sans-serif}
.hidden{display:none!important}.result{text-align:center}.score{font-size:64px;color:var(--gold);margin:12px}.result p{font:15px/1.6 Arial,sans-serif;color:var(--muted)}.pill{display:inline-block;padding:7px 12px;border:1px solid #66502d;border-radius:30px;color:var(--gold2);font:12px Arial,sans-serif}
.footer{text-align:center;color:#828997;font:12px Arial,sans-serif;margin:20px 0}
@media(max-width:560px){body{padding:14px}.answers{grid-template-columns:1fr}.levels{gap:6px}.level{font-size:13px}.level small{font-size:10px}.actions{flex-direction:column}}
</style>
</head>
<body>
<div class="wrap">
<header class="top"><div class="eyebrow">A musical knowledge challenge</div><h1>The Musical <span>Instruments</span></h1><p>Test your knowledge • Learn instrument families • Have fun</p></header>
<main class="card">
<section id="start">
<div class="pill">CHOOSE YOUR LEVEL</div>
<div class="levels">
<button class="level active" data-level="easy">Easy<small>5 questions</small></button>
<button class="level" data-level="medium">Medium<small>7 questions</small></button>
<button class="level" data-level="hard">Hard<small>8 questions</small></button>
</div>
<p style="color:var(--muted);font:14px/1.6 Arial,sans-serif">Choose an answer for each question. You’ll get instant feedback and your final score at the end.</p>
<button class="primary" id="startBtn">START QUIZ →</button>
</section>
<section id="game" class="hidden">
<div class="meta"><span id="counter">Question 1 / 5</span><span id="scoreLive">Score: 0</span></div>
<div class="bar"><div class="fill" id="progress"></div></div>
<h2 class="q" id="question"></h2>
<div class="answers" id="answers"></div>
<div id="feedback" class="feedback hidden" aria-live="polite"></div>
<div class="actions"><button class="primary" id="nextBtn" disabled>CHECK ANSWER</button><button class="secondary" id="quitBtn">Exit</button></div>
</section>
<section id="result" class="result hidden">
<div class="pill">QUIZ COMPLETED</div><h2>Your final score</h2><div class="score" id="finalScore">0/5</div><h3 id="resultTitle"></h3><p id="resultText"></p><button class="primary" id="againBtn">PLAY AGAIN</button>
</section>
</main>
<div class="footer">THE MUSICAL INSTRUMENTS • Learn something new every day</div>
</div>
<script>
const bank={
easy:[
["Which instrument usually has six strings?",["Piano","Guitar","Flute","Drums"],1,"A standard guitar usually has six strings."],
["Which instrument belongs to the wind family?",["Violin","Saxophone","Piano","Drums"],1,"The saxophone produces sound using a reed and vibrating air."],
["Which instrument is usually played with a bow?",["Guitar","Violin","Trumpet","Piano"],1,"The violin is commonly played with a bow."],
["Which instrument belongs to the percussion family?",["Flute","Drums","Organ","Guitar"],1,"Drums are percussion instruments: they are struck to make sound."],
["Which instrument is played using a keyboard?",["Saxophone","Violin","Piano","Cymbals"],2,"The piano produces sound when its keys trigger hammers to strike strings."]
],
medium:[
["Which family does the flute belong to?",["String","Brass","Woodwind","Percussion"],2,"The flute is a woodwind instrument, although modern flutes are often made of metal."],
["What is the lowest-pitched common member of the violin family?",["Viola","Cello","Double bass","Violin"],2,"The double bass is the largest and lowest-pitched standard member of the violin family."],
["Which instrument uses a double reed?",["Clarinet","Oboe","Flute","Trumpet"],1,"The oboe uses two reeds vibrating against each other."],
["Which instrument is commonly associated with jazz improvisation?",["Saxophone","Triangle","Timpani","Recorder"],0,"The saxophone is strongly associated with jazz, though many instruments can improvise."],
["What does a cymbal belong to?",["Keyboard","Percussion","String","Woodwind"],1,"Cymbals are percussion instruments, usually made of metal."],
["Which instrument has pedals that sustain notes?",["Harp","Piano","Clarinet","Snare drum"],1,"The piano commonly has pedals, including a sustain pedal."],
["Which instrument is played by blowing across an opening?",["Flute","Cello","Guitar","Timpani"],0,"A concert flute is played by blowing across its embouchure hole."]
],
hard:[
["Which brass instrument commonly uses a slide to change pitch?",["French horn","Trombone","Trumpet","Tuba"],1,"The trombone uses a telescoping slide to change the length of its tubing."],
["How many strings does a standard orchestral harp usually have?",["24","36","47","60"],2,"A standard concert pedal harp typically has 47 strings."],
["Which instrument is a free-reed instrument?",["Accordion","Oboe","Viola","Trombone"],0,"An accordion makes sound when air passes over free reeds."],
["Which percussion instrument has tuned metal bars?",["Xylophone","Snare drum","Bass drum","Tambourine"],0,"A xylophone has tuned wooden bars; a similar instrument with metal bars is a metallophone or glockenspiel."],
["What is the usual tuning of a standard four-string bass guitar, from low to high?",["E-A-D-G","A-D-G-C","D-G-B-E","C-G-D-A"],0,"A standard four-string bass is tuned E-A-D-G from lowest to highest."],
["Which instrument is transposing and commonly pitched in B-flat?",["Violin","B-flat clarinet","Piano","Trombone"],1,"The B-flat clarinet sounds a whole step lower than written."],
["Which instrument family does the marimba belong to?",["String","Woodwind","Keyboard","Percussion"],3,"The marimba is a pitched percussion instrument with wooden bars."],
["What is the mouthpiece of a trumpet called?",["Reed","Embouchure","Bell","Mute"],1,"Embouchure refers to the way a player shapes and uses the lips on the mouthpiece."]
]};
let level="easy",list=[],index=0,score=0,chosen=null,locked=false;
const $=id=>document.getElementById(id);
document.querySelectorAll(".level").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll(".level").forEach(x=>x.classList.remove("active"));b.classList.add("active");level=b.dataset.level;}));
function show(id){["start","game","result"].forEach(x=>$(x).classList.toggle("hidden",x!==id))}
function start(){list=[...bank[level]];index=0;score=0;show("game");render()}
function render(){chosen=null;locked=false;$("feedback").classList.add("hidden");$("nextBtn").disabled=true;$("nextBtn").textContent="CHECK ANSWER";$("counter").textContent=`Question ${index+1} / ${list.length}`;$("scoreLive").textContent=`Score: ${score}`;$("progress").style.width=`${index/list.length*100}%`;$("question").textContent=list[index][0];$("answers").innerHTML="";
list[index][1].forEach((a,i)=>{let b=document.createElement("button");b.className="answer";b.innerHTML=`<span class="letter">${"ABCD"[i]}</span><span>${a}</span>`;b.addEventListener("click",()=>{if(locked)return;chosen=i;document.querySelectorAll(".answer").forEach(x=>x.classList.remove("selected"));b.classList.add("selected");$("nextBtn").disabled=false});$("answers").appendChild(b)})}
function check(){if(!locked){locked=true;let correct=list[index][2],ok=chosen===correct;if(ok)score++;document.querySelectorAll(".answer").forEach((b,i)=>{b.disabled=true;if(i===correct)b.classList.add("correct");else if(i===chosen)b.classList.add("wrong")});$("feedback").className="feedback "+(ok?"good":"bad");$("feedback").textContent=(ok?"Correct! ":"Not quite. ")+list[index][3];$("nextBtn").textContent=index===list.length-1?"SEE RESULTS":"NEXT QUESTION →";$("scoreLive").textContent=`Score: ${score}`;return}
if(index<list.length-1){index++;render()}else finish()}
function finish(){show("result");let total=list.length;$("finalScore").textContent=`${score}/${total}`;$("resultTitle").textContent=score===total?"Excellent! Perfect score!":score>=Math.ceil(total*.6)?"Great job! Keep learning!":"Good effort! Practice makes progress.";$("resultText").textContent=`You answered ${score} out of ${total} questions correctly on the ${level} level.`;$("progress").style.width="100%"}
$("startBtn").onclick=start;$("nextBtn").onclick=check;$("quitBtn").onclick=()=>show("start");$("againBtn").onclick=()=>show("start");
</script>
</body></html>
